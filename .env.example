# AlertBot configuration — copy to .env and fill in.
# Everything under "Notifications" and "Escalation" can also be changed at
# runtime from the Settings page; these values only seed the database.

APP_NAME=AlertBot
DATABASE_URL=sqlite:///alerts.db
# PostgreSQL later:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/alertbot

# --- Mailbox (IMAP) ---------------------------------------------------------
# Gmail needs an App Password with IMAP enabled — not your normal password.
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
CHECK_INTERVAL=30

# --- Notifications ----------------------------------------------------------
# ntfy: install the ntfy app, subscribe to this topic. Keep it unguessable.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# MacroDroid cloud webhook that fires the loud alarm macro.
MACRODROID_WEBHOOK_URL=

# Firebase service account. Locally: a file path. On Render: paste the whole
# JSON into FIREBASE_CREDENTIALS_JSON instead.
FIREBASE_CREDENTIALS=credentials/firebase.json
FIREBASE_CREDENTIALS_JSON=

# --- Escalation -------------------------------------------------------------
ESCALATION_REPEAT_MINUTES=2
ESCALATION_AFTER_MINUTES=10
ESCALATION_TICK_SECONDS=20

# --- Access -----------------------------------------------------------------
# Leave DASHBOARD_PASSWORD empty for no login (local use only).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Shared key the Android app sends when registering its push token.
DEVICE_REGISTRATION_KEY=

# Used in push notifications so tapping one opens the right dashboard.
PUBLIC_URL=http://127.0.0.1:8000
