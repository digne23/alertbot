<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#7A0E12"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨"
        android:textSize="64sp" />

    <TextView
        android:id="@+id/alarm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="CRITICAL"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarm_service"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="#FFD9DA"
        android:textSize="19sp"
        android:typeface="monospace" />

    <TextView
        android:id="@+id/alarm_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="#FFEBEC"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/alarm_incident"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="#FFB3B4"
        android:textSize="13sp"
        android:typeface="monospace" />

    <Button
        android:id="@+id/alarm_ack"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="34dp"
        android:backgroundTint="#2FD48A"
        android:text="@string/acknowledge"
        android:textColor="#04220F"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/alarm_snooze"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#4A1517"
        android:text="@string/silence_here"
        android:textColor="#FFD9DA" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/silence_hint"
        android:textColor="#E39B9C"
        android:textSize="12sp" />
</LinearLayout>
