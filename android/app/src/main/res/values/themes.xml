<?xml version="1.0" encoding="utf-8"?>
<!--
  Compose draws every surface, so these themes only need to set the window
  chrome before the first frame. Framework parents keep us off AppCompat.
-->
<resources>

    <style name="Theme.AlertBot" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/brand_blue</item>
        <item name="android:navigationBarColor">@color/surface_page</item>
        <item name="android:windowBackground">@color/surface_page</item>
    </style>

    <style name="Theme.AlertBot.Alarm" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/alarm_background</item>
        <item name="android:navigationBarColor">@color/alarm_background</item>
        <item name="android:windowBackground">@color/alarm_background</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

</resources>
