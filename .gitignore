android/.gradle/
android/build/
android/app/build/
android/local.properties
.idea/
*.iml

# Built APK, fetched from CI for sideloading — not source
app/static/*.apk
# ...and the artifact zip it arrives in
alertbot-apk*.zip

# Session scratch notes, not project documentation
STATUS.md
